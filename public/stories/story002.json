          ],
          "note": "ㅂ sa presúva do ďalšej slabiky"
        }
      ]
    },
    {
      "id": 8,
      "paragraph": 2,
      "text": "버스를 타고 학교에 가요.",
      "start": 22.48,
      "end": 24.44,
      "translations": {
        "sk": "Nastúpi do autobusu a ide do školy."
      },
      "pronunciation": "버스를 타고 학꾜에 가요.",
      "assimilation": [
        {
          "text": "학교에",
          "pronunciation": "학꾜에",
          "rules": [
            "tensification"
          ],
          "note": "ㄱ po ㄱ znie napäto ako ㄲ"
        }
      ]
    },
    {
      "id": 9,
      "paragraph": 2,
      "text": "학교에서 친구를 만나요.",
      "start": 25.14,
      "end": 26.94,
      "translations": {
